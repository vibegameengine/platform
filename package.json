{
  "name": "@vibegameengine/platform",
  "version": "1.0.1",
  "description": "Cross-platform game service layer with mock and provider adapters",
  "license": "MIT",
  "keywords": [
    "platform",
    "games",
    "ads",
    "leaderboard",
    "storage"
  ],
  "homepage": "https://github.com/vibegameengine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibegameengine/platform.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.0"
  }
}